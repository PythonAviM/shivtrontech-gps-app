from django.shortcuts import render
from .models import Contact

def home(request):
    if request.method == "POST":
        Contact.objects.create(
            name=request.POST.get("name"),
            email=request.POST.get("email"),
            phone=request.POST.get("phone"),
            message=request.POST.get("message"),
        )
        return render(request, "home.html", {"success": True})

    return render(request, "home.html")





from django.http import JsonResponse
from django.views.decorators.csrf import csrf_exempt
from django.utils import timezone
import json

from .models import Device, DeviceData, Geofence, UserFCMToken
from .utils import send_fcm_v1

from math import radians, cos, sin, asin, sqrt

# 🔥 distance function
def calculate_distance(lat1, lon1, lat2, lon2):
    lon1, lat1, lon2, lat2 = map(radians,
        [lon1, lat1, lon2, lat2])

    dlon = lon2 - lon1
    dlat = lat2 - lat1

    a = sin(dlat/2)**2 + cos(lat1)*cos(lat2)*sin(dlon/2)**2
    c = 2 * asin(sqrt(a))

    return 6371 * c * 1000  # meters


@csrf_exempt
def upload_location(request):

    if request.method == "POST":
        try:
            data = json.loads(request.body.decode())
        except:
            return JsonResponse({'status': 'error', 'message': 'Invalid JSON'}, status=400)
    else:
        data = request.GET

    device_id = data.get('device_id')
    latitude = data.get('latitude')
    longitude = data.get('longitude')
    speed = data.get('speed') or 0

    if not device_id or not latitude or not longitude:
        return JsonResponse({'status': 'error', 'message': 'Missing fields'}, status=400)

    # ✅ Device check
    device = Device.objects.filter(device_id=device_id).first()
    if not device:
        return JsonResponse({'status': 'error', 'message': 'Device not registered'}, status=404)

    # ✅ Save data
    DeviceData.objects.create(
        device=device,
        latitude=latitude,
        longitude=longitude,
        speed=speed,
        timestamp=timezone.now()
    )
    # 🔥 GEOFENCE CHECK START
    # 🔥 GEOFENCE CHECK START
    try:
        geofence = Geofence.objects.filter(device=device).order_by('-id').first()

        print("👉 GEOFENCE ID =>", geofence.id if geofence else None)
        print("👉 NOTIFICATION STATUS =>", geofence.notification_enabled if geofence else None)

        # ❌ NO GEOFENCE
        if not geofence:
            return JsonResponse({'status': 'success'})

        # 🔥 HARD STOP (MOST IMPORTANT)
        if geofence.notification_enabled is not True:
            print("🚫 NOTIFICATION BLOCKED")
            return JsonResponse({'status': 'blocked'})

        # 🔥 DISTANCE CALCULATION
        dist = calculate_distance(
            float(latitude),
            float(longitude),
            geofence.latitude,
            geofence.longitude
        )

        print("DISTANCE =>", dist)

        if dist > geofence.radius:

            print("🚨 OUTSIDE GEOFENCE")

            tokens = UserFCMToken.objects.filter(user=device.user)

            for t in tokens:
                send_fcm_v1(
                    t.token,
                    "🚨 Geofence Alert",
                    f"{device.device_id} is OUTSIDE geofence!"
                )

    except Exception as e:
        print("❌ GEOFENCE ERROR:", str(e))
    
    # try:
    #     # 🔥 latest geofence uthao (important)
    #     geofence = Geofence.objects.filter(device=device, is_active=True).order_by('-id').first()

    #     print("GEOFENCE =>", geofence)

    #     # ❌ agar geofence hi nahi hai
    #     if not geofence:
    #         print("❌ NO GEOFENCE FOUND")
    #         return JsonResponse({'status': 'success', 'message': 'Location saved'})

    #     # 🔥 NOTIFICATION STATUS CHECK (MOST IMPORTANT)
    #     print("NOTIFICATION STATUS =>", geofence.notification_enabled)

    #     if geofence.notification_enabled == False:
    #         print("🚫 NOTIFICATION DISABLED")
    #         return JsonResponse({'status': 'success', 'message': 'Location saved'})

    #     # 🔥 DISTANCE CALCULATION
    #     dist = calculate_distance(
    #         float(latitude),
    #         float(longitude),
    #         geofence.latitude,
    #         geofence.longitude
    #     )

    #     print("DISTANCE =>", dist)

    #     if dist > geofence.radius:

    #         print("🚨 OUTSIDE GEOFENCE")

    #         tokens = UserFCMToken.objects.filter(user=device.user)

    #         for t in tokens:
    #             send_fcm_v1(
