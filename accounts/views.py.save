from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework.permissions import IsAuthenticated
from .models import Device, Geofence

class CreateGeofenceAPI(APIView):
    permission_classes = [IsAuthenticated]

    def post(self, request):

        # 🔥 GET DATA
        device_id = request.data.get("device_id")
        lat = request.data.get("lat")
        lng = request.data.get("lng")
        radius = request.data.get("radius")
        notification_enabled = request.data.get("notification_enabled", True)

        # 🔥 FIX BOOLEAN ISSUE (VERY IMPORTANT)
        if str(notification_enabled).lower() == "false":
            notification_enabled = False
        else:
            notification_enabled = True

        print("📡 NOTIFICATION ENABLED =>", notification_enabled)

        # 🔥 VALIDATION
        if not device_id or not lat or not lng or not radius:
            return Response({"error": "All fields required"}, status=400)

        # 🔥 SAFE FLOAT CONVERSION
        try:
            lat = float(lat)
            lng = float(lng)
            radius = float(radius)
        except Exception as e:
            return Response({"error": "Invalid numeric values"}, status=400)

        # 🔥 DEVICE CHECK
        device = Device.objects.filter(
            device_id=device_id,
            user=request.user
        ).first()

        if not device:
            return Response({"error": "Invalid device"}, status=400)

        # 🔥 CREATE OR UPDATE GEOFENCE
        geofence, created = Geofence.objects.update_or_create(
            device=device,
            defaults={
                "latitude": lat,
                "longitude": lng,
                "radius": radius,
                "is_active": True,
                "notification_enabled": notification_enabled
            }
        )

        return Response({
            "message": "Geofence created" if created else "Geofence updated",
            "device_id": device.device_id,
            "lat": lat,
            "lng": lng,
            "radius": radius,
            "notification_enabled": notification_enabled
        })



class GetGeofenceAPI(APIView):
    permission_classes = [IsAuthenticated]

    def get(self, request, device_id):

        # 🔥 DEVICE CHECK
        device = Device.objects.filter(
            device_id=device_id,
            user=request.user
        ).first()

        if not device:
            return Response({"error": "Invalid device"}, status=400)

        # 🔥 GET GEOFENCE
        geofence = Geofence.objects.filter(device=device).first()

        if not geofence:
            return Response({
                "message": "No geofence found",
                "lat": None,
                "lng": None,
                "radius": None,
                "notification_enabled": True
            })

        return Response({
            "lat": geofence.latitude,
            "lng": geofence.longitude,
            "radius": geofence.radius,
            "notification_enabled": geofence.notification_enabled
        })


from rest_framework.views import APIView
from rest_framework.response import Response
from rest_framework.permissions import IsAuthenticated
from .models import Device, Geofence

class ToggleGeofenceNotificationAPI(APIView):
    permission_classes = [IsAuthenticated]

    def post(self, request):

        device_id = request.data.get("device_id")
        status = request.data.get("status")  # true / false

        if device_id is None or status is None:
            return Response({"error": "device_id and status required"}, status=400)

        # 🔥 BOOLEAN FIX
        if str(status).lower() == "false":
            status = False
        else:
            status = True

        device = Device.objects.filter(
            device_id=device_id,
            user=request.user
        ).first()

        if not device:
            return Response({"error": "Invalid device"}, status=400)

        geofence = Geofence.objects.filter(device=device).order_by('-id').first()

        if not geofence:
            return Response({"error": "Geofence not found"}, status=404)

        geofence.notification_enabled = status
        geofence.save()

        return Response({
            "message": "Notification updated",
            "notification_enabled": geofence.notification_enabled
        })






import random
from django.core.mail import send_mail
from rest_framework.decorators import api_view, permission_classes
from rest_framework.permissions import IsAuthenticated
from rest_framework.response import Response
from django.utils import timezone
from datetime import timedelta

from .models import AppPinOTP


# 🔥 SEND OTP
@api_view(['POST'])
@permission_classes([IsAuthenticated])
def app_pin_send_otp(request):

    user = request.user

    otp = str(random.randint(100000, 999999))

    # पुराना delete
    AppPinOTP.objects.filter(user=user).delete()

    # नया save
    AppPinOTP.objects.create(user=user, otp=otp)

    # email send
    send_mail(
        subject="App PIN Reset OTP",
        message=f"Your OTP is {otp}",
        from_email="yourgmail@gmail.com",
        recipient_list=[user.email],
    )

    return Response({"message": "OTP sent"})


# 🔥 VERIFY OTP
@api_view(['POST'])
@permission_classes([IsAuthenticated])
def app_pin_verify_otp(request):

    user = request.user
    otp = request.data.get("otp")

    otp_obj = AppPinOTP.objects.filter(user=user, otp=otp).first()

    if not otp_obj:
        return Response({"error": "Invalid OTP"}, status=400)

    # expiry check (2 min)
    if timezone.now() - otp_obj.created_at > timedelta(minutes=2):
        otp_obj.delete()
        return Response({"error": "OTP expired"}, status=400)

    otp_obj.delete()

    return Response({"message": "OTP verified"})


























# =====================================================
# GET ALL ACTIVE PLANS
# =====================================================

@api_view(['GET'])
def get_plans(request):

    plans = SubscriptionPlan.objects.filter(
        is_active=True
    )

    data = []

    for p in plans:

        data.append({

            "id": p.id,

            "name": p.name,

            "price": p.price,

            "duration_days": p.duration_days,
        })

    return Response(data)














# =====================================================
# CREATE RAZORPAY ORDER
# =====================================================

@api_view(['POST'])
@permission_classes([IsAuthenticated])
def create_order(request):

    plan_id = request.data.get("plan_id")

    plan = SubscriptionPlan.objects.get(
        id=plan_id
    )

    order = client.order.create({

        "amount": int(plan.price) * 100,

        "currency": "INR",

        "payment_capture": 1
    })

    return Response({

        "order_id": order["id"],

        "amount": plan.price,

        "plan_name": plan.name,

        "razorpay_key":
            settings.RAZORPAY_KEY_ID
    })









# =====================================================
# PAYMENT SUCCESS
# =====================================================

@api_view(['POST'])
@permission_classes([IsAuthenticated])
def payment_success(request):

    payment_id = request.data.get(
        "payment_id"
    )

    plan_id = request.data.get(
        "plan_id"
    )

    device_id = request.data.get(
        "device_id"
    )

    # 🔥 GET PLAN

    plan = SubscriptionPlan.objects.get(
        id=plan_id
    )

    # 🔥 GET DEVICE

    device = Device.objects.get(
        device_id=device_id,
        user=request.user
    )

    # 🔥 DEACTIVATE OLD SUBSCRIPTIONS

    DeviceSubscription.objects.filter(
        device=device,
        is_active=True
    ).update(is_active=False)

    # 🔥 CREATE NEW SUBSCRIPTION

    DeviceSubscription.objects.create(

        user=request.user,

        device=device,

        plan=plan,

        amount=plan.price,

        start_date=timezone.now(),

        end_date=timezone.now() +
        timedelta(days=plan.duration_days),

        is_active=True,

        razorpay_payment_id=payment_id
    )

    return Response({

        "message":
            "Subscription Activated",

        "device":
            device.device_id,

        "plan":
            plan.name
    })










# =====================================================
# DEVICE CURRENT SUBSCRIPTION
# =====================================================

@api_view(['GET'])
@permission_classes([IsAuthenticated])
def device_subscription(request, device_id):

    try:

        device = Device.objects.get(
            device_id=device_id,
            user=request.user
        )

    except Device.DoesNotExist:

        return Response({
            "error": "Device not found"
        })

    sub = DeviceSubscription.objects.filter(
        device=device,
        is_active=True
    ).last()

    # ❌ NO ACTIVE PLAN

    if not sub:

        return Response({
            "active": False
        })

    # 🔥 REMAINING DAYS

    remaining_days = (
        sub.end_date - timezone.now()
    ).days

    # 🔥 EXPIRED CHECK

    expired = remaining_days <= 0

    return Response({

        "active": True,

        "device":
            device.device_id,

        "plan":
            sub.plan.name,

        "price":
            sub.amount,

        "start_date":
            sub.start_date,

        "end_date":
            sub.end_date,

        "remaining_days":
            remaining_days,

        "expired":
            expired
    })















# =====================================================
# DEVICE PAYMENT HISTORY
# =====================================================

@api_view(['GET'])
@permission_classes([IsAuthenticated])
def payment_history(request, device_id):

    try:

        device = Device.objects.get(
            device_id=device_id,
            user=request.user
        )

    except Device.DoesNotExist:

        return Response({
            "error": "Device not found"
        })

    subscriptions = DeviceSubscription.objects.filter(
        device=device
    ).order_by('-id')

    data = []

    for sub in subscriptions:

        data.append({

            "plan":
                sub.plan.name,

            "amount":
                sub.amount,

            "start_date":
                sub.start_date,

            "end_date":
                sub.end_date,

            "active":
                sub.is_active,

            "payment_id":
                sub.razorpay_payment_id
        })

    return Response(data)
